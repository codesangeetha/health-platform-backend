{
  "name": "health-platform-backend",
  "version": "1.0.0",
  "description": "Comprehensive Health Management Platform Backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/infrastructure/entry-points/api/index.ts",
    "test": "mocha test/**/*.spec.ts",
    "test:watch": "mocha --watch test/**/*.spec.ts",
    "test:coverage": "nyc --reporter=text --reporter=lcov mocha test/**/*.spec.ts",
    "test:unit": "mocha test/unit/**/*.spec.ts",
    "test:integration": "mocha test/integration/**/*.spec.ts",
    "test:single": "mocha"
  },
  "keywords": [
    "healthcare",
    "platform",
    "nodejs",
    "typescript",
    "clean-architecture"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mailtrap": "^4.2.0",
    "mongoose": "^8.0.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/chai": "^5.2.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/mocha": "^10.0.10",
    "@types/mongoose": "^5.11.9",
    "@types/node": "^20.10.4",
    "@types/sinon": "^17.0.4",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "chai": "^4.3.4",
    "chai-http": "^4.3.0",
    "eslint": "^8.54.0",
    "jest": "^30.0.5",
    "mocha": "^11.7.1",
    "sinon": "^21.0.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.4",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ]
  }
}
